<?xml version="1.0" encoding="utf-8"?>
<!--
    Android's default posture, applied explicitly: cleartext HTTP is forbidden
    for every host (TrafficProbe switched to HTTPS-only endpoints in October
    2026, so no domain exception is needed anymore) and only system CA roots
    are trusted - user-added / debug CAs are never accepted, which closes off
    a trivial MitM via a proxy certificate installed on the device.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
